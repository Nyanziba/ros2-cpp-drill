def cmd_watch(exercises, args):
    ex = resolve(exercises, args[0] if args else None)
    if ex is None:
        print(green(localized("全課題クリア済みです。", "You have finished every exercise.")))
        return 0
    print()
    print(bold(localized("  watch モード（Ctrl-C で終了）", "  watch mode (Ctrl-C to quit)")))
    for src in sources(ex):
        print(dim(localized(f"  監視中: {src}", f"  Watching: {src}")))

    def fingerprint(exercise):
        return tuple(s.stat().st_mtime if s.exists() else 0.0 for s in sources(exercise))

    last = None
    try:
        while True:
            now = fingerprint(ex)
            if now != last:
                last = now
                if _COLOR:
                    print("\033[2J\033[H", end="")
                passed = check(ex)
                report(ex, passed, exercises)
                if passed and is_done(ex):
                    nxt = next((e for e in exercises if not is_done(e)), None)
                    if nxt is None:
                        return 0
                    ex, last = nxt, None
                    print(dim(localized(f"\n  次の課題に移りました: {nxt['id']}", f"\n  Moving on to the next exercise: {nxt['id']}")))
                    continue
                print(dim(localized("\n  保存すると自動で再テストします...", "\n  Tests will run again when you save...")))
            time.sleep(0.5)
    except KeyboardInterrupt:
        print(localized("\n終了しました。", "\nStopped."))
        return 0


