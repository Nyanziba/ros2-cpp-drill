def _filter_candidates(candidates, cur):
    """前方一致を優先し、無ければ部分一致で絞る。

    resolve() が "publisher" のような部分一致を受け付けるので、補完も
    同じように効かないと打てる文字列と補完できる文字列がずれる。
    bash の compgen は前方一致しかできないため、絞り込みは Python 側でやる。
    """
    if not cur:
        return candidates
    prefix = [c for c in candidates if c.startswith(cur)]
    if prefix:
        return prefix
    return [c for c in candidates if cur in c]


def _emit_candidates(candidates, cur):
    """候補を1行1件で出す。0件のときは1バイトも出さない。

    空行を出すと bash の mapfile が「空文字列1件」として読んでしまい、
    打ちかけの語が消される。0件のときは黙るのが正しい。
    """
    matched = _filter_candidates(candidates, cur)
    if matched:
        print("\n".join(matched))


def page_url(path):
    """docs/ の .md に対応するページの URL を返す。無ければ (None, 理由)。

    探す順番:
      1. DRILL_DOCS_URL（自分でサイトを建てている人の指定を最優先）
      2. 手元でビルドした site/（file:// で開く）
      3. SITE_URL（公開版に埋め込まれる GitHub Pages の URL）

    MkDocs は use_directory_urls: false で建てているので、.md はそのまま
    .html になります。ただし README.md だけは index.html です。
    """
    try:
        rel = path.resolve().relative_to((ROOT / "docs").resolve())
    except ValueError:
        return None, f"{path} は docs/ の外にあります"
    html = rel.with_name("index.html") if rel.name == "README.md" \
        else rel.with_suffix(".html")
    href = "/".join(html.parts)

    base = os.environ.get("DRILL_DOCS_URL", "").rstrip("/")
    if base:
        return f"{base}/{href}", None

    local = ROOT / "site" / html
    if local.exists():
        return local.as_uri(), None

    if SITE_URL:
        return f"{SITE_URL.rstrip('/')}/{href}", None

    return None, "サイトがまだありません"


DOCS_VENV = ROOT / ".venv-docs"


def find_mkdocs():
    """使える mkdocs を探す。無ければ None。"""
    local = DOCS_VENV / "bin" / "mkdocs"
    if local.exists():
        return str(local)
    return shutil.which("mkdocs")


def build_site():
    """読み物のサイトを site/ に建てる。成功したら True。

    mkdocs が無ければ .venv-docs に用意します。既存の環境を汚さないよう、
    システムの Python には入れません。
    """
    mkdocs = find_mkdocs()
    if mkdocs is None:
        print(dim("  mkdocs が無いので .venv-docs/ に用意します（初回だけ・数十秒）"))
        sys.stdout.flush()
        code = subprocess.call([sys.executable, "-m", "venv", str(DOCS_VENV)])
        if code != 0:
            # 失敗すると中途半端なディレクトリが残る。消しておかないと
            # 次回 find_mkdocs が「あるのに動かない」状態を踏む。
            shutil.rmtree(DOCS_VENV, ignore_errors=True)
            print(red("  仮想環境を作れませんでした。"))
            print(yellow("  Ubuntu では python3-venv が別パッケージです:"))
            print(yellow("    sudo apt install python3-venv"))
            print(dim("  入れられない場合は、公開サイトを指定する手もあります:"))
            print(dim("    DRILL_DOCS_URL=https://example.com/docs ./drill read --web"))
            return False
        req = ROOT / "docs-requirements.txt"
        code = subprocess.call(
            [str(DOCS_VENV / "bin" / "pip"), "install", "-q", "-r", str(req)])
        if code != 0:
            print(red("  依存のインストールに失敗しました。"))
            return False
        mkdocs = str(DOCS_VENV / "bin" / "mkdocs")

    print(dim("  サイトをビルドしています..."))
    sys.stdout.flush()
    # --strict は付けない。読むために建てるだけなので、リンク切れ 1 つで
    # 読めなくなるほうが困る（CI のほうで --strict を掛けている）。
    if subprocess.call([mkdocs, "build"], cwd=ROOT) != 0:
        print(red("  ビルドに失敗しました。"))
        return False
    print(green("  site/ を作りました。"))
    return True


def ask_yes(question):
    """[Y/n] で尋ねる。対話できない場面（CI・パイプ）では False。"""
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        return False
    try:
        answer = input(f"  {question} [Y/n]: ").strip().lower()
    except (EOFError, KeyboardInterrupt):
        print()
        return False
    return answer in ("", "y", "yes")


def in_container():
    """Docker の中かどうか。ブラウザが無いし、パスもホストと食い違う。"""
    return Path("/.dockerenv").exists() or os.environ.get("DRILL_IN_CONTAINER") == "1"


def open_in_browser(url, rel_hint=None):
    """ブラウザで開く。開けなくても URL は必ず出す（端末から辿れるように）。"""
    print(cyan(f"  {url}"))
    print()

    if in_container():
        # コンテナにブラウザは無い。file:// を出しても、そのパスは
        # コンテナの中を指しているのでホストのブラウザでは開けない。
        # site/ はバインドマウントの上にあるので、ホスト側から開ける
        # 相対パスを案内する。
        if rel_hint:
            print(dim("  コンテナの中なのでブラウザは開けません。"))
            print(dim("  ホスト側でリポジトリ直下から開いてください:"))
            print(cyan(f"    {rel_hint}"))
        else:
            print(dim("  コンテナの中なのでブラウザは開けません。上の URL を開いてください。"))
        return 0

    sys.stdout.flush()          # ブラウザ側が先に何か書いても順番が崩れないように
    # SSH 先などにもブラウザは無い。webbrowser は False を返すか、
    # 環境によっては例外を投げるので、どちらでも URL 表示で終わらせる。
    try:
        if webbrowser.open(url):
            return 0
    except Exception:
        pass
    print(dim("  ブラウザを開けませんでした。上の URL を開いてください。"))
    return 0


def cmd_read(exercises, args):
    """課題に対応する講習資料を開く。

    既定は PAGER（less）です。--web を付けるとブラウザで開きます。
    サイトのほうが章送り・目次・全文検索が付くので通読には楽です。
    """
    web = force_build = False
    rest = []
    for a in args:
        if a in ("--web", "-w"):
            web = True
        elif a == "--build":
            web = force_build = True
        else:
            rest.append(a)

    ex = resolve(exercises, rest[0] if rest else None)
    if ex is None:
        print(green("全課題クリア済みです。"))
        return 0
    ref = lecture_ref(ex)
    if ref is None:
        die(f"{ex['id']} には対応する講習資料が登録されていません。")
    title, path, exists = ref
    if not exists:
        die(f"資料が見つかりません: {path}")
    print(dim(f"  {ex['id']}  →  {title}"))

    if web:
        if force_build:
            build_site()
        url, why = page_url(path)
        if url is None:
            # 初回はここに来る。作るかどうか聞いてから作る。
            print(yellow(f"  {why}"))
            if ask_yes("いま作りますか？（数十秒）") and build_site():
                url, why = page_url(path)
            else:
                print(dim("  作るときは ./drill read --build "
                          + short_id(ex) + " です。"))
                print(dim("  公開サイトがあるなら "
                          "DRILL_DOCS_URL=... を指定してください。"))
        if url:
            rel = None
            if url.startswith("file://"):
                try:
                    rel = "site/" + str(Path(path).resolve()
                                        .relative_to((ROOT / "docs").resolve())
                                        .with_suffix(".html"))
                except ValueError:
                    rel = None
            return open_in_browser(url, rel)
        print(dim("  代わりに手元の Markdown を開きます。"))
        print()

    print(cyan(f"  {path}"))
    print()
    # ページャは fd 1 に直接書く。こちらの print はパイプ越しだとブロック
    # バッファされるので、流しておかないと見出しがページャの出力より
    # **後ろ**に出る（./drill read | head で踏む）。
    sys.stdout.flush()
    pager = os.environ.get("PAGER")
    if pager:
        return subprocess.call([pager, str(path)])
    for name in ("less", "more"):
        if shutil.which(name):
            return subprocess.call([name, str(path)])
    # ページャが無い環境では中身をそのまま流す
    print(path.read_text(encoding="utf-8"))
    return 0


def cmd_complete(exercises, args):
    """タブ補完の候補を1行1件で出す（補完スクリプトが内部で呼ぶ）。

    ./drill __complete commands                → コマンド名の一覧
    ./drill __complete args <直前の語> [入力中の語] → 引数の候補
    """
    what = args[0] if args else "commands"
    cur = args[2] if len(args) > 2 else ""
    if what == "commands":
        # __complete 自身は隠す（人が打つものではない）
        _emit_candidates(sorted(c for c in COMMANDS if not c.startswith("__")), cur)
        return 0
    if what == "args":
        prev = args[1] if len(args) > 1 else ""
        if prev == "read":
            # read だけはブラウザで開く指定を取る
            _emit_candidates([ex["id"] for ex in exercises] + ["--web", "--build"], cur)
        elif prev in ID_COMMANDS:
            _emit_candidates([ex["id"] for ex in exercises], cur)
        elif prev == "completion":
            _emit_candidates(["bash", "zsh"], cur)
    return 0


def cmd_completion(_exercises, args):
    """補完スクリプトを標準出力に書く。"""
    shell = (args[0] if args else "bash").lstrip("-")
    if shell == "bash":
        print(BASH_COMPLETION, end="")
        return 0
    if shell == "zsh":
        print(ZSH_COMPLETION, end="")
        return 0
    die(f"未知のシェル: {shell}（bash または zsh を指定してください）")


COMMANDS = {
    "list": cmd_list,
    "run": cmd_run,
    "watch": cmd_watch,
    "hint": cmd_hint,
    "doc": cmd_doc,
    "read": cmd_read,
    "solution": cmd_solution,
    "reset": cmd_reset,
    "verify": cmd_verify,
    "completion": cmd_completion,
    "__complete": cmd_complete,
}


def main(argv):
    if argv and argv[0] in ("-h", "--help", "help"):
        print(__doc__)
        return 0
    name = argv[0] if argv else "list"
    if name not in COMMANDS:
        print(__doc__)
        die(f"不明なコマンド: {name}")
    return COMMANDS[name](load_exercises(), argv[1:])


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
