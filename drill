# 課題 ID を引数に取るコマンド。補完で課題名を出す対象。
ID_COMMANDS = ("run", "watch", "hint", "doc", "read", "solution", "reset")

BASH_COMPLETION = r'''# ros2-drill のタブ補完（bash）
#
# 有効にするには ~/.bashrc に次の行を足してください。
#   source /path/to/ros2-drill/completion/drill.bash
#
# 候補は ./drill 自身に問い合わせるので、課題を追加しても
# このファイルを書き換える必要はありません。
#
# 絞り込みも ./drill 側でやっています（compgen は前方一致しかできないが、
# ./drill run publisher のような部分一致も補完したいため）。
_drill_complete()
{
  local exe cur prev
  exe="${COMP_WORDS[0]}"
  cur="${COMP_WORDS[COMP_CWORD]}"
  prev="${COMP_WORDS[COMP_CWORD-1]}"

  # コマンド自体を補完する
  if [ "$COMP_CWORD" -eq 1 ]; then
    mapfile -t COMPREPLY < <("$exe" __complete commands "" "$cur" 2>/dev/null)
    return 0
  fi

  # コマンドの引数を補完する
  mapfile -t COMPREPLY < <("$exe" __complete args "$prev" "$cur" 2>/dev/null)
  return 0
}
complete -F _drill_complete drill ./drill
'''

ZSH_COMPLETION = r'''# ros2-drill のタブ補完（zsh）
#
# 有効にするには ~/.zshrc に次の行を足してください。
#   source /path/to/ros2-drill/completion/drill.zsh
_drill_complete()
{
  local exe="${words[1]}"
  local cur="${words[CURRENT]}"
  if (( CURRENT == 2 )); then
    compadd -- ${(f)"$("$exe" __complete commands '' "$cur" 2>/dev/null)"}
  else
    compadd -- ${(f)"$("$exe" __complete args "${words[CURRENT-1]}" "$cur" 2>/dev/null)"}
  fi
}
compdef _drill_complete drill ./drill
'''


def _filter_candidates(candidates, cur):
    """前方一致を優先し、無ければ部分一致で絞る。

    resolve() が "publisher" のような部分一致を受け付けるので、補完も
    同じように効かないと打てる文字列と補完できる文字列がずれる。
    bash の compgen は前方一致しかできないため、絞り込みは Python 側でやる。
    """
    if not cur:
        return candidates
    prefix = [c for c in candidates if c.startswith(cur)]
    if prefix:
        return prefix
    return [c for c in candidates if cur in c]


def _emit_candidates(candidates, cur):
    """候補を1行1件で出す。0件のときは1バイトも出さない。

    空行を出すと bash の mapfile が「空文字列1件」として読んでしまい、
    打ちかけの語が消される。0件のときは黙るのが正しい。
    """
    matched = _filter_candidates(candidates, cur)
    if matched:
        print("\n".join(matched))


def site_page(path):
    """docs/ か docs-en/ の .md に対応する、サイト内の HTML 相対パス。外なら None。

    docs/X.md -> X.html、docs-en/X.md -> en/X.html（README.md は index.html）。
    ROS_DISTRO が lyrical なら、頭に lyrical/ が付く（Lyrical 版のサイト）。
    """
    resolved = path.resolve()
    for source_dir, site_prefix in (("docs", ""), ("docs-en", "en")):
        try:
            rel = resolved.relative_to((ROOT / source_dir).resolve())
        except ValueError:
            continue
        html = rel.with_name("index.html") if rel.name == "README.md" \
            else rel.with_suffix(".html")
        distro_prefix = "lyrical" if SITE_DISTRO == "lyrical" else ""
        return Path(distro_prefix) / site_prefix / html
    return None


def page_url(path):
    """docs/ か docs-en/ の .md に対応するページの URL を返す。無ければ (None, 理由)。

    探す順番:
      1. DRILL_DOCS_URL（自分でサイトを建てている人の指定を最優先）
      2. 手元でビルドした site/（file:// で開く）
      3. SITE_URL（配信しているサイトがあれば）

    MkDocs は use_directory_urls: false で建てているので、.md はそのまま
    .html になります。ただし README.md だけは index.html です。
    """
    page = site_page(path)
    if page is None:
        return None, localized(f"{path} は docs/ の外にあります",
                               f"{path} is outside docs/ and docs-en/")
    html = page
    href = "/".join(html.parts)

    base = os.environ.get("DRILL_DOCS_URL", "").rstrip("/")
    if base:
        return f"{base}/{href}", None

    local = ROOT / "site" / html
    if local.exists():
        return local.as_uri(), None

    if SITE_URL:
        return f"{SITE_URL.rstrip('/')}/{href}", None

    # 手元にサイトが無い。別のサイトで配信しているトラックならそちらを開く。
    # 英語ページは en/ の下にあるので、トラック名は en/ を除いた先頭で見る。
    track_parts = html.parts[1:] if html.parts[:1] == ("en",) else html.parts
    if MIRROR_URL and track_parts and track_parts[0] in MIRROR_TRACKS:
        return f"{MIRROR_URL.rstrip('/')}/{href}", "mirror"

    return None, localized("サイトがまだありません", "The site has not been built yet")


DOCS_VENV = ROOT / ".venv-docs"
ENGLISH_MKDOCS_CONFIG = ROOT / "mkdocs.en.yml"
# Lyrical 版のサイト（site/lyrical/ と site/lyrical/en/）。ROS の公式イメージは中で ROS_DISTRO を
# 設定するので、Lyrical のコンテナでは Lyrical 版のページを開く。手元（未設定）では Jazzy 版。
SITE_DISTRO = os.environ.get("ROS_DISTRO", "jazzy")
LYRICAL_MKDOCS_CONFIGS = (ROOT / "mkdocs.lyrical.yml", ROOT / "mkdocs.lyrical.en.yml")


def find_mkdocs():
    """使える mkdocs を探す。無ければ None。"""
    local = DOCS_VENV / "bin" / "mkdocs"
    if local.exists():
        return str(local)
    return shutil.which("mkdocs")


def build_site():
    """読み物のサイトを site/ に建てる。成功したら True。

    mkdocs が無ければ .venv-docs に用意します。既存の環境を汚さないよう、
    システムの Python には入れません。
    """
    mkdocs = find_mkdocs()
    if mkdocs is None:
        print(dim(localized("  mkdocs が無いので .venv-docs/ に用意します（初回だけ・数十秒）",
                            "  mkdocs is missing, so I will set it up in .venv-docs/ (first time only, tens of seconds)")))
        sys.stdout.flush()
        code = subprocess.call([sys.executable, "-m", "venv", str(DOCS_VENV)])
        if code != 0:
            # 失敗すると中途半端なディレクトリが残る。消しておかないと
            # 次回 find_mkdocs が「あるのに動かない」状態を踏む。
            shutil.rmtree(DOCS_VENV, ignore_errors=True)
            print(red(localized("  仮想環境を作れませんでした。", "  Could not create a virtual environment.")))
            print(yellow(localized("  Ubuntu では python3-venv が別パッケージです:",
                                   "  On Ubuntu, python3-venv is a separate package:")))
            print(yellow("    sudo apt install python3-venv"))
            print(dim(localized("  入れられない場合は、公開サイトを指定する手もあります:",
                                "  If you cannot install it, you can point to a published site instead:")))
            print(dim("    DRILL_DOCS_URL=https://example.com/docs ./drill read --web"))
            return False
        req = ROOT / "docs-requirements.txt"
        code = subprocess.call(
            [str(DOCS_VENV / "bin" / "pip"), "install", "-q", "-r", str(req)])
        if code != 0:
            print(red(localized("  依存のインストールに失敗しました。", "  Failed to install the dependencies.")))
            return False
        mkdocs = str(DOCS_VENV / "bin" / "mkdocs")

    print(dim(localized("  サイトをビルドしています...", "  Building the site...")))
    sys.stdout.flush()
    # --strict は付けない。読むために建てるだけなので、リンク切れ 1 つで
    # 読めなくなるほうが困る（CI のほうで --strict を掛けている）。
    # 順番が重要: 日本語のビルドが site/ を作り直すので、英語（site/en/）は後に建てる。
    if subprocess.call([mkdocs, "build"], cwd=ROOT) != 0:
        print(red(localized("  日本語版のビルドに失敗しました。", "  The Japanese site build failed.")))
        return False
    # 英語版の失敗で日本語の利用者まで巻き込まない。英語モードのときだけ失敗扱いにする。
    if ENGLISH_MKDOCS_CONFIG.exists() and \
            subprocess.call([mkdocs, "build", "-f", str(ENGLISH_MKDOCS_CONFIG)], cwd=ROOT) != 0:
        print(yellow(localized("  英語版（site/en/）のビルドに失敗しました。",
                               "  The English site build (site/en/) failed.")))
        if IS_ENGLISH:
            return False
    # Lyrical 版は Jazzy 版の後に建てる（Jazzy 版の日本語のビルドが site/ を作り直すため）。
    if SITE_DISTRO == "lyrical":
        for config in LYRICAL_MKDOCS_CONFIGS:
            if subprocess.call([mkdocs, "build", "-f", str(config)], cwd=ROOT) != 0:
                print(red(localized(f"  Lyrical 版（{config.name}）のビルドに失敗しました。",
                                    f"  The Lyrical site build ({config.name}) failed.")))
                return False
    print(green(localized("  site/ を作りました。", "  Built site/.")))
    return True


def ask_yes(question):
    """[Y/n] で尋ねる。対話できない場面（CI・パイプ）では False。"""
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        return False
    try:
        answer = input(f"  {question} [Y/n]: ").strip().lower()
    except (EOFError, KeyboardInterrupt):
        print()
        return False
    return answer in ("", "y", "yes")


def in_container():
    """Docker の中かどうか。ブラウザが無いし、パスもホストと食い違う。"""
    return Path("/.dockerenv").exists() or os.environ.get("DRILL_IN_CONTAINER") == "1"


def open_in_browser(url, rel_hint=None):
    """ブラウザで開く。開けなくても URL は必ず出す（端末から辿れるように）。"""
    print(cyan(f"  {url}"))
    print()

    if in_container():
        # コンテナにブラウザは無い。file:// を出しても、そのパスは
        # コンテナの中を指しているのでホストのブラウザでは開けない。
        # site/ はバインドマウントの上にあるので、ホスト側から開ける
        # 相対パスを案内する。
        if rel_hint:
            print(dim(localized("  コンテナの中なのでブラウザは開けません。", "  You are inside a container, so I cannot open a browser.")))
            print(dim(localized("  ホスト側でリポジトリ直下から開いてください:", "  On the host, open this from the repository root:")))
            print(cyan(f"    {rel_hint}"))
        else:
            print(dim(localized("  コンテナの中なのでブラウザは開けません。上の URL を開いてください。", "  You are inside a container, so I cannot open a browser. Open the URL above.")))
        return 0

    sys.stdout.flush()          # ブラウザ側が先に何か書いても順番が崩れないように
    # SSH 先などにもブラウザは無い。webbrowser は False を返すか、
    # 環境によっては例外を投げるので、どちらでも URL 表示で終わらせる。
    try:
        if webbrowser.open(url):
            return 0
    except Exception:
        pass
    print(dim(localized("  ブラウザを開けませんでした。上の URL を開いてください。", "  Could not open a browser. Open the URL above.")))
    return 0


def cmd_read(exercises, args):
    """課題に対応する講習資料を開く。

    既定は PAGER（less）です。--web を付けるとブラウザで開きます。
    サイトのほうが章送り・目次・全文検索が付くので通読には楽です。
    """
    web = force_build = False
    rest = []
    for a in args:
        if a in ("--web", "-w"):
            web = True
        elif a == "--build":
            web = force_build = True
        else:
            rest.append(a)

    ex = resolve(exercises, rest[0] if rest else None)
    if ex is None:
        print(green(localized("全課題クリア済みです。", "You have finished every exercise.")))
        return 0
    ref = lecture_ref(ex)
    if ref is None:
        die(localized(f"{ex['id']} には対応する講習資料が登録されていません。",
                      f"No lecture notes are registered for {ex['id']}."))
    title, path, exists = ref
    if not exists:
        die(localized(f"資料が見つかりません: {path}", f"Lecture notes not found: {path}"))
    print(dim(f"  {ex['id']}  →  {title}"))

    if web:
        if force_build:
            build_site()
        url, why = page_url(path)
        if url is None:
            # 手元にも配信先にも無いトラック。
            print(yellow(f"  {why}"))
            if ask_yes(localized("いま作りますか？（数十秒）", "Build it now? (tens of seconds)")) and build_site():
                url, why = page_url(path)
            else:
                print(dim(localized(
                    f"  作るときは ./drill read --build {short_id(ex)} です。",
                    f"  To build it, run ./drill read --build {short_id(ex)}.")))
                print(dim(localized(
                    "  公開サイトがあるなら DRILL_DOCS_URL=... を指定してください。",
                    "  If you have a published site, set DRILL_DOCS_URL=...")))
        elif why == "mirror":
            print(dim("  " + MIRROR_NOTE))
            print(dim("  " + MIRROR_NOTE2 + localized(" ./drill read --build ", " Run ./drill read --build ")
                      + short_id(ex) + localized(" で。", ".")))
        if url:
            page = site_page(path) if url.startswith("file://") else None
            return open_in_browser(url, f"site/{page}" if page else None)
        print(dim(localized("  代わりに手元の Markdown を開きます。", "  I will open the local Markdown file instead.")))
        print()

    print(cyan(f"  {path}"))
    print()
    # ページャは fd 1 に直接書く。こちらの print はパイプ越しだとブロック
    # バッファされるので、流しておかないと見出しがページャの出力より
    # **後ろ**に出る（./drill read | head で踏む）。
    sys.stdout.flush()
    pager = os.environ.get("PAGER")
    if pager:
        return subprocess.call([pager, str(path)])
    for name in ("less", "more"):
        if shutil.which(name):
            return subprocess.call([name, str(path)])
    # ページャが無い環境では中身をそのまま流す
    print(path.read_text(encoding="utf-8"))
    return 0


def cmd_complete(exercises, args):
    """タブ補完の候補を1行1件で出す（補完スクリプトが内部で呼ぶ）。

    ./drill __complete commands                → コマンド名の一覧
    ./drill __complete args <直前の語> [入力中の語] → 引数の候補
    """
    what = args[0] if args else "commands"
    cur = args[2] if len(args) > 2 else ""
    if what == "commands":
        # __complete 自身は隠す（人が打つものではない）
        _emit_candidates(sorted(c for c in COMMANDS if not c.startswith("__")), cur)
        return 0
    if what == "args":
        prev = args[1] if len(args) > 1 else ""
        if prev == "read":
            # read だけはブラウザで開く指定を取る
            _emit_candidates([ex["id"] for ex in exercises] + ["--web", "--build"], cur)
        elif prev in ID_COMMANDS:
            _emit_candidates([ex["id"] for ex in exercises], cur)
        elif prev == "completion":
            _emit_candidates(["bash", "zsh"], cur)
    return 0


def cmd_completion(_exercises, args):
    """補完スクリプトを標準出力に書く。"""
    shell = (args[0] if args else "bash").lstrip("-")
    if shell == "bash":
        print(BASH_COMPLETION, end="")
        return 0
    if shell == "zsh":
        print(ZSH_COMPLETION, end="")
        return 0
    die(localized(f"未知のシェル: {shell}（bash または zsh を指定してください）",
              f"Unknown shell: {shell} (use bash or zsh)"))


COMMANDS = {
    "list": cmd_list,
    "run": cmd_run,
    "watch": cmd_watch,
    "hint": cmd_hint,
    "doc": cmd_doc,
    "read": cmd_read,
    "solution": cmd_solution,
    "reset": cmd_reset,
    "verify": cmd_verify,
    "completion": cmd_completion,
    "__complete": cmd_complete,
}


def main(argv):
    if argv and argv[0] in ("-h", "--help", "help"):
        print(HELP_EN if IS_ENGLISH else __doc__)
        return 0
    name = argv[0] if argv else "list"
    if name not in COMMANDS:
        print(HELP_EN if IS_ENGLISH else __doc__)
        die(localized(f"不明なコマンド: {name}", f"Unknown command: {name}"))
    return COMMANDS[name](load_exercises(), argv[1:])


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
