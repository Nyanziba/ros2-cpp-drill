# ---------------------------------------------------------------- 表示まわり

_COLOR = sys.stdout.isatty() and os.environ.get("NO_COLOR") is None


def _c(code, text):
    return f"\033[{code}m{text}\033[0m" if _COLOR else text


def bold(t):
    return _c("1", t)


def green(t):
    return _c("32", t)


def red(t):
    return _c("31", t)


def yellow(t):
    return _c("33", t)


def dim(t):
    return _c("2", t)


def cyan(t):
    return _c("36", t)


def localized(japanese, english):
    """利用者向けの文言を言語に合わせて選ぶ。"""
    return english if IS_ENGLISH else japanese


def field(exercise, key, default=None):
    """課題の項目を返す。英語モードでは <key>_en があればそちらを使う。"""
    if IS_ENGLISH and f"{key}_en" in exercise:
        return exercise[f"{key}_en"]
    return exercise.get(key, default)


def die(msg):
    print(red(f"{localized('エラー', 'Error')}: {msg}"), file=sys.stderr)
    sys.exit(1)


def disp_width(text):
    """端末上の表示幅。全角は 2 桁として数える。"""
    return sum(2 if ord(ch) > 0x2E80 else 1 for ch in text)


def pad(text, width):
    """表示幅を揃えて右に空白を足す（f-string の :<N は文字数なので全角で崩れる）。"""
    return text + " " * max(0, width - disp_width(text))


def rule(title):
    fill = max(0, 62 - disp_width(title))
    print()
    print(bold(f"━━━ {title} " + "━" * fill))
    print()


# ---------------------------------------------------------------- 課題データ


def load_exercises():
    if not CONFIG.exists():
        die(localized(f"{CONFIG} が見つかりません。", f"{CONFIG} not found."))
    return json.loads(CONFIG.read_text(encoding="utf-8"))["exercises"]


def short_id(ex):
    """課題 ID の先頭部分（"01_publisher" -> "01"、"c03_inheritance" -> "c03"）。

    ./drill run などに渡せる最短のトークンを返す。ROS 2 編は 2 桁だが
    C++ 編は "c" + 2 桁なので、先頭 2 文字を切るだけでは "c0" になってしまう。
    """
    return ex["id"].split("_", 1)[0]


def lecture_ref(ex):
    """その課題に対応する講習資料の (表示名, 絶対パス, 存在するか)。無ければ None。

    Docs と Drill を 1 対 1 で対応させているので、課題の進捗がそのまま
    「どこまで読んだか」の目安になる。list と doc の両方から使う。
    """
    lecture = field(ex, "lecture") or []
    if not lecture:
        return None
    ref = lecture[0]
    path = (ROOT / ref["path"]).resolve()
    return ref["title"], path, path.exists()


def exercise_dir(ex):
    return EXERCISES_DIR / ex["id"]


def sources(ex):
    """受講者が編集するファイルの絶対パス一覧。"""
    return [exercise_dir(ex) / rel for rel in ex["sources"]]


def is_done(ex):
    """すべての編集対象から MARKER が消えていれば「完了申告済み」とみなす。"""
    found_any = False
    for src in sources(ex):
        if not src.exists():
            return False
        found_any = True
        if MARKER in src.read_text(encoding="utf-8"):
            return False
    return found_any


def resolve(exercises, token):
    """"01" / "01_publisher" / "publisher" / "c01" のいずれでも課題を引く。

    候補の探し方を段階に分け、先の段階で 1 件に決まったらそこで確定する。
    段階を分けないと "01" が 01_publisher と c01_build_and_link の両方に
    当たって曖昧になる（"01" は "c01_build_and_link" の部分文字列でもある）。
    """
    if token is None:
        for ex in exercises:
            if not is_done(ex):
                return ex
        return None
    token = token.strip().strip("/")

    # ① ID 完全一致  ② 短縮 ID 完全一致  ③ 前方一致  ④ 部分一致
    tiers = (
        [ex for ex in exercises if ex["id"] == token],
        [ex for ex in exercises if short_id(ex) == token],
        [ex for ex in exercises if ex["id"].startswith(token)],
        [ex for ex in exercises if token in ex["id"]],
    )
    for matches in tiers:
        if len(matches) == 1:
            return matches[0]
        if len(matches) > 1:
            candidates = ", ".join(m["id"] for m in matches)
            die(localized(
                f"課題の指定が曖昧です: {candidates}\n"
                f"       もっと詳しく指定してください（例: {short_id(matches[0])}）",
                f"The exercise is ambiguous: {candidates}\n"
                f"       Please be more specific (for example: {short_id(matches[0])})"))
    die(localized(
        f"課題 '{token}' が見つかりません。./drill list で一覧を確認してください。",
        f"Exercise '{token}' not found. Run ./drill list to see all exercises."))


# ---------------------------------------------------------------- ROS 環境


def find_ros_setup():
    candidates = []
    prefix = os.environ.get("ROS_ROOT_PREFIX")
    if prefix:
        candidates.append(Path(prefix) / "setup.bash")
    opt = Path("/opt/ros")
    if opt.is_dir():
        candidates += sorted((d / "setup.bash" for d in opt.iterdir() if d.is_dir()), reverse=True)
    return next((c for c in candidates if c.exists()), None)


def ros_env():
    env = os.environ.copy()
    # 同じ LAN の他の受講者と DDS が混信しないよう閉じておく。
    env.setdefault("ROS_AUTOMATIC_DISCOVERY_RANGE", "LOCALHOST")
    env.setdefault("ROS_DOMAIN_ID", str(1 + os.getuid() % 99))
    env.setdefault("COLCON_LOG_PATH", str(ROOT / "log"))
    # rclcpp のテンプレートは 1 つの g++ で 1GB 近く食うことがある。
    # コア数ぶん並列に走らせるとメモリ不足で落ちるので、既定で絞る。
    # DRILL_COMPILE_JOBS で上書きできる。
    env.setdefault("MAKEFLAGS", "-j" + env.get("DRILL_COMPILE_JOBS", "2"))
    return env


def ros_run(argv, capture=True, overlay=None):
    """ROS 2 環境下でコマンドを実行する。返り値は (returncode, 出力)。

    overlay に install ディレクトリを渡すと、その setup.bash も source する
    （launch や ros2 run を使うテストで必要）。
    """
    env = ros_env()
    prelude = []
    if not env.get("ROS_DISTRO"):
        setup = find_ros_setup()
        if setup is None:
            die(localized(
                "ROS 2 が見つかりません。\n"
                "  source /opt/ros/jazzy/setup.bash を実行してから、もう一度お試しください。",
                "ROS 2 not found.\n"
                "  Run source /opt/ros/jazzy/setup.bash and try again."))
        prelude.append(str(setup))
    if overlay is not None and Path(overlay).exists():
        prelude.append(str(overlay))

    if prelude:
        script = "".join(f'. "{p}" > /dev/null; ' for p in prelude) + 'exec "$@"'
        cmd = ["bash", "-c", script, "drill"] + argv
    else:
        cmd = argv

    if capture:
        proc = subprocess.run(
            cmd, cwd=ROOT, env=env, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True
        )
        return proc.returncode, proc.stdout
    return subprocess.call(cmd, cwd=ROOT, env=env), ""


# ---------------------------------------------------------------- ビルド/テスト


BUILD_ARGS = ["--executor", "sequential", "--parallel-workers", "1"]


def build(ex):
    """課題をビルドする。成功したら True。"""
    print(dim(localized("  ビルド中...", "  Building...")), flush=True)
    code, out = ros_run(
        ["colcon", "build", "--packages-select", ex["package"]] + BUILD_ARGS)
    if code != 0:
        print(red(localized("  ✗ ビルドに失敗しました", "  ✗ Build failed")))
        print()
        if any(rel.endswith((".msg", ".srv", ".action")) for rel in ex["sources"]):
            print(yellow(localized(
                "  この課題は、インターフェース定義（.msg / .srv）が未完成のうちは\n"
                "  ビルドが通りません。定義したフィールドが C++ の型に生えないので、\n"
                "  「has no member named ...」というエラーが大量に出ます。\n"
                "  まず定義ファイルを書いてください。エラーの数は気にしなくて大丈夫です。",
                "  This exercise does not build until the interface definition (.msg / .srv)\n"
                "  is finished. The fields do not exist in the C++ types yet, so you will\n"
                "  see many \"has no member named ...\" errors.\n"
                "  Write the definition file first. Do not worry about the number of errors.")))
            print()
        lines = out.splitlines()
        head = lines[:40]
        for line in head:
            print("  " + line)
        if len(lines) > len(head):
            print(dim(localized(
                f"  … 以下 {len(lines) - len(head)} 行省略（全文は log/latest_build/ にあります）",
                f"  ... {len(lines) - len(head)} more lines omitted (full log: log/latest_build/)")))
        print()
        print(dim(localized(
            "  まずはビルドを通すところから。型名やセミコロンを確認しましょう。\n"
            "  「undefined reference」が出ている場合は、関数の中身が空のままです。",
            "  First, make the build pass. Check type names and semicolons.\n"
            "  If you see \"undefined reference\", a function body is still empty.")))
        return False
    return True


def run_tests(ex):
    """テストを実行する。全部通れば True。"""
    kind = ex.get("kind", "gtest")
    if kind == "gtest":
        binary = ROOT / "build" / ex["package"] / GTEST_TARGET
        if not binary.exists():
            die(localized(f"テスト実行ファイルが見つかりません: {binary}", f"Test executable not found: {binary}"))
        argv = [str(binary)]
        if _COLOR:
            argv.append("--gtest_color=yes")
        # カスタムインターフェースを持つ課題では、生成された typesupport の
        # 共有ライブラリを実行時に dlopen する。install 空間を source しないと
        # 「Type support not from this implementation」で落ちるため overlay を渡す。
        code, _ = ros_run(argv, capture=False, overlay=ROOT / "install" / "setup.bash")
        return code == 0
    if kind == "pytest":
        test_file = exercise_dir(ex) / "test" / "test_exercise.py"
        argv = [sys.executable, "-m", "pytest", "-q", "--no-header", str(test_file)]
        code, _ = ros_run(argv, capture=False, overlay=ROOT / "install" / "setup.bash")
        return code == 0
    if kind == "gtest_mutation":
        # 受講者が「テストを書く」課題。2 つの実装に対して同じテストを走らせる。
        #   test_exercise … 正しい実装 → 通らなければならない
        #   test_mutant   … わざとバグを入れた実装 → 落ちなければならない
        #                   （落ちないテストは、何も検証していないということ）
        correct = ROOT / "build" / ex["package"] / GTEST_TARGET
        mutant = ROOT / "build" / ex["package"] / "test_mutant"
        for path in (correct, mutant):
            if not path.exists():
                die(localized(f"テスト実行ファイルが見つかりません: {path}", f"Test executable not found: {path}"))

        print(dim(localized("  [1/2] 正しい実装に対して、あなたのテストを実行します", "  [1/2] Running your tests against the correct implementation")))
        argv = [str(correct)] + (["--gtest_color=yes"] if _COLOR else [])
        code_correct, _ = ros_run(argv, capture=False)
        passed_correct = code_correct == 0
        print()

        print(dim(localized(
            "  [2/2] わざとバグを入れた実装に対して、同じテストを実行します\n"
            "        （ここで落ちれば「バグを検出できるテスト」になっています）",
            "  [2/2] Running the same tests against an implementation with a bug on purpose\n"
            "        (If they fail here, your tests can catch the bug.)")))
        code_mutant, out = ros_run([str(mutant)], capture=True)
        detected = code_mutant != 0
        if detected:
            print(green(localized("  ✓ バグを検出しました", "  ✓ The bug was detected")))
        else:
            print(red(localized("  ✗ バグ入りの実装なのに、あなたのテストは全部通ってしまいました", "  ✗ The implementation has a bug, but all of your tests passed")))
            print()
            for line in out.splitlines()[-15:]:
                print("  " + line)
            print()
            print(dim(localized(
                "  テストが assert していない、または観点が足りていません。\n"
                "  README の「検出すべきバグ」を読み直してください。",
                "  Your tests do not assert enough, or they miss a case.\n"
                "  Read the \"bugs to detect\" section of the README again.")))
        return passed_correct and detected
    die(localized(f"未知のテスト種別: {kind}", f"Unknown test kind: {kind}"))


def check(ex, announce=True):
    """1 課題をビルドしてテストする。合格なら True。"""
    if announce:
        rule(f"{field(ex, 'level')} {ex['id']}: {field(ex, 'title')}")
    if not build(ex):
        return False
    print()
    return run_tests(ex)


def report(ex, passed, exercises):
    print()
    if not passed:
        print(red(localized(f"  ✗ 課題 {ex['id']} は未完了です",
                            f"  ✗ Exercise {ex['id']} is not finished")))
        readme_name = "README.en.md" if IS_ENGLISH and (exercise_dir(ex) / "README.en.md").exists() \
            else "README.md"
        print(dim(f"     {localized('課題文:  ', 'Task:    ')} {exercise_dir(ex) / readme_name}"))
        for src in sources(ex):
            print(dim(f"     {localized('編集する:', 'Edit:    ')} {src}"))
        print(dim(f"     {localized('ヒント:  ', 'Hints:   ')} ./drill hint {short_id(ex)}"))
        return

    print(green(localized("  ✓ すべてのテストに合格しました！", "  ✓ All tests passed!")))
    remaining = [s for s in sources(ex) if MARKER in s.read_text(encoding="utf-8")]
    if remaining:
        print()
        print(yellow(localized("  次に進むには、下の行を削除してください:", "  To move on, delete the line below:")))
        print(cyan(f"      // {MARKER}"))
        for src in remaining:
            print(dim(f"      ({src})" if IS_ENGLISH else f"      （{src}）"))
    else:
        nxt = next((e for e in exercises if not is_done(e)), None)
        if nxt:
            print(dim(f"     {localized('次の課題:', 'Next:')} ./drill run {short_id(nxt)}   ({field(nxt, 'title')})"))
        else:
            print()
            print(green(bold(localized("  🎉 全課題クリアです。おつかれさまでした！", "  🎉 You finished every exercise. Great work!"))))


# ---------------------------------------------------------------- コマンド


def cmd_list(exercises, _args):
    print()
    print(bold(localized("  ROS 2 練習帳", "  ROS 2 Drill")))
    current = next((e for e in exercises if not is_done(e)), None)
    level = None
    for ex in exercises:
        if field(ex, "level") != level:
            level = field(ex, "level")
            print()
            print(bold(f"  【{level}】" if not IS_ENGLISH else f"  [{level}]")
                  + dim(f"  {field(ex, 'level_note', '')}"))
        done = is_done(ex)
        if done:
            mark, label = green("✓"), ex["id"]
        elif ex is current:
            mark, label = yellow("▶"), bold(ex["id"])
        else:
            mark, label = " ", dim(ex["id"])
        suffix = dim(localized("  ← 今ここ", "  <- you are here")) if ex is current else ""
        chapter = field(ex, "chapter", "")
        ch = dim(f"[{chapter}]") if chapter else ""
        # label は色付きなのでエスケープを含む。幅計算は素の id で行う。
        id_pad = " " * max(0, 22 - disp_width(ex["id"]))
        print(f"    {mark} {label}{id_pad} {pad(field(ex, 'title'), 34)} {ch}{suffix}")
    done_count = sum(1 for e in exercises if is_done(e))
    print()
    print(dim(f"  {localized('進捗', 'Progress')}: {done_count} / {len(exercises)}"))
    print(dim(localized("  [ ] 内が対応する講習資料の章です。./drill read ID でその章を開けます。", "  The text in [ ] is the matching chapter of the lecture notes. Run ./drill read ID to open it.")))
    print()
    return 0


def cmd_run(exercises, args):
    ex = resolve(exercises, args[0] if args else None)
    if ex is None:
        print(green(localized("全課題クリア済みです。./drill verify で通しで確認できます。", "You have finished every exercise. Run ./drill verify to test them all in one go.")))
        return 0
    passed = check(ex)
    report(ex, passed, exercises)
    return 0 if passed else 1


def cmd_verify(exercises, _args):
    failed = None
    for ex in exercises:
        if not check(ex):
            failed = ex
            report(ex, False, exercises)
            break
        print(green(f"\n  ✓ {ex['id']} {localized('合格', 'passed')}"))
    print()
    if failed:
        print(red(localized(f"  {failed['id']} で止まりました。", f"  Stopped at {failed['id']}.")))
        return 1
    print(green(bold(localized("  全課題のテストに合格しています。", "  All exercises pass."))))
    print()
    return 0


def cmd_hint(exercises, args):
    if not args:
        die(localized("課題 ID を指定してください（例: ./drill hint 01）", "Please give an exercise ID (for example: ./drill hint 01)"))
    ex = resolve(exercises, args[0])
    rule(f"{localized('ヒント', 'Hints')} — {ex['id']}: {field(ex, 'title')}")
    for line in field(ex, "hints", [localized("（ヒントは用意されていません）", "(No hints are available.)")]):
        print("  " + line)
    print()
    print(dim(f"  {localized('公式ドキュメント:', 'Official docs:   ')} ./drill doc {short_id(ex)}"))
    print(dim(f"  {localized('行き詰まったら:  ', 'If you are stuck:')} ./drill solution {short_id(ex)}"))
    print()
    return 0


def cmd_doc(exercises, args):
    if not args:
        die(localized("課題 ID を指定してください（例: ./drill doc 01）", "Please give an exercise ID (for example: ./drill doc 01)"))
    ex = resolve(exercises, args[0])
    rule(f"{localized('参考資料', 'References')} — {ex['id']}: {field(ex, 'title')}")

    lecture = field(ex, "lecture", [])
    if lecture:
        print(bold(localized("  対応する講習資料", "  Matching lecture notes")))
        for ref in lecture:
            path = (ROOT / ref["path"]).resolve()
            mark = "" if path.exists() else dim(localized("  ← 見つかりません", "  <- not found"))
            print(f"    {ref['title']}{mark}")
            print(cyan(f"      {path}"))
        print()

    docs = field(ex, "docs", [])
    if docs:
        print(bold(localized("  公式ドキュメント", "  Official documentation")))
        for doc in docs:
            print(f"    {doc['title']}")
            print(cyan(f"      {doc['url']}"))
        print()
    return 0


